# Supabase (project site-hassle, eu-west-1)
NEXT_PUBLIC_SUPABASE_URL=https://oyntcaxzskzntiyzxquy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses RLS. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=oyntcaxzskzntiyzxquy

# Public origin used in magic links, canonical URLs and the sitemap.
# Defaults to http://localhost:3000 (links fall back to the request host).
NEXT_PUBLIC_SITE_URL=

# Stripe (Task 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: email notices (Resend). Without RESEND_API_KEY every notice is a logged no-op.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Pieza 3D <avisos@tudominio.es>".
# Empty: Resend's test sender (only delivers to the Resend account owner).
NOTIFY_FROM_EMAIL=
# Who gets the «pieza en revisión» heads-up.
ADMIN_NOTIFY_EMAIL=
# Shared with the worker (.env at the repo root): enables POST /api/internal/notify.
WORKER_SHARED_SECRET=

# Contact address shown on /privacidad.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: ads measurement. Empty = no third-party script is loaded and no cookie banner.
# With an id, the banner asks first; nothing loads until the visitor accepts.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
