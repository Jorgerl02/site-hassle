# Copia este fichero a .env y rellena las claves. Nunca subas .env al repositorio.
TRIPO_API_KEY=
MESHY_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Ruta absoluta al ejecutable de Blender (probado con 5.2) (p. ej. /Applications/Blender.app/Contents/MacOS/Blender)
BLENDER_BIN=
# Tolerancia de escala: error relativo máximo por eje para «escala» 5 y apto (0.03 = 3 %).
# Se puede cambiar por comando con --scale-tolerance (run, eval, refine).
SCALE_TOLERANCE=0.03

# Worker de la plataforma (uv run platform-worker run). Las claves de Supabase están en
# platform/.env.local (no las subas nunca).
SUPABASE_URL=https://oyntcaxzskzntiyzxquy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Proveedor de las piezas orgánicas: fake (GLB de prueba, solo desarrollo) | tripo | fal.
# Vacío: solo se generan piezas rectilíneas; las orgánicas quedan como fallidas con el motivo.
PROVIDER=
# Clave de fal.ai (PROVIDER=fal) y modelo: trellis (por defecto) o hunyuan3d.
FAL_KEY=
FAL_MODEL=trellis
